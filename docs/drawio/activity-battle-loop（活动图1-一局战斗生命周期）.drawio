        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml usecase-diagram\nskinparam defaultFontName \&quot;Noto Sans CJK SC\&quot;\nleft to right direction\nskinparam packageStyle rectangle\nskinparam actorStyle awesome\n\nactor \&quot;玩家\&quot; as Player\nactor \&quot;系统定时器\&quot; as Timer\n\nrectangle \&quot;飞机大战（单人单机版）\&quot; {\n    usecase \&quot;开始游戏\&quot; as UC1\n    usecase \&quot;初始化战场\&quot; as UC1a\n    usecase \&quot;移动战机\&quot; as UC2\n    usecase \&quot;自动发射子弹\&quot; as UC3\n    usecase \&quot;生成敌机\&quot; as UC4\n    usecase \&quot;敌机移动与射击\&quot; as UC5\n    usecase \&quot;碰撞检测与击毁\&quot; as UC6\n    usecase \&quot;计分\&quot; as UC6a\n    usecase \&quot;玩家受击判定\&quot; as UC7\n    usecase \&quot;游戏结束判定\&quot; as UC9\n    usecase \&quot;暂停/恢复\&quot; as UC12\n    usecase \&quot;拾取道具\&quot; as UC10\n    usecase \&quot;查询最高分\&quot; as UC13\n}\n\nPlayer --&gt; UC1\nPlayer --&gt; UC2\nPlayer --&gt; UC12\nPlayer --&gt; UC10\nPlayer --&gt; UC13\n\nTimer --&gt; UC3\nTimer --&gt; UC4\nTimer --&gt; UC5\nTimer --&gt; UC6\nTimer --&gt; UC7\nTimer --&gt; UC9\n\nUC1 ..&gt; UC1a : &lt;&lt;include&gt;&gt;\nUC6 ..&gt; UC6a : &lt;&lt;include&gt;&gt;\n\nnote bottom of UC1\n  P0 覆盖：\n  能开始(UC1) → 能进行(UC2~UC7)\n  → 能结束(UC9)\nend note\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0gnnCN16CAb7R19-QBHD-1">
