@startuml usecase-diagram
skinparam defaultFontName "Noto Sans CJK SC"
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "玩家" as Player
actor "系统定时器" as Timer

rectangle "飞机大战（单人单机版）" {
    usecase "开始游戏" as UC1
    usecase "初始化战场" as UC1a
    usecase "移动战机" as UC2
    usecase "自动发射子弹" as UC3
    usecase "生成敌机" as UC4
    usecase "敌机移动与射击" as UC5
    usecase "碰撞检测与击毁" as UC6
    usecase "计分" as UC6a
    usecase "玩家受击判定" as UC7
    usecase "游戏结束判定" as UC9
    usecase "暂停/恢复" as UC12
    usecase "拾取道具" as UC10
    usecase "查询最高分" as UC13
}

Player --> UC1
Player --> UC2
Player --> UC12
Player --> UC10
Player --> UC13

Timer --> UC3
Timer --> UC4
Timer --> UC5
Timer --> UC6
Timer --> UC7
Timer --> UC9

UC1 ..> UC1a : <<include>>
UC6 ..> UC6a : <<include>>

note bottom of UC1
  P0 覆盖：
  能开始(UC1) → 能进行(UC2~UC7)
  → 能结束(UC9)
end note
@enduml
